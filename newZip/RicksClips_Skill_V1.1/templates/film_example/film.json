 "sentences": [
  {
   "text": "This station master stopped every clock in town, on purpose.",
   "words": [
    0,
    9
   ],
   "subject": "master",
   "nouns": [
    {
     "word": "clock",
     "show": "watch"
    }
   ]
  },
  {
   "text": "Trains kept crashing, because each town kept its own time.",
   "words": [
    10,
    19
   ],
   "subject": "master",
   "show": [
    "train"
   ],
   "nouns": [
    {
     "word": "trains",
     "show": "train"
    },
    {
     "word": "own",
     "show": "watches"
    }
   ]
  },
  {
   "text": "So he hung one giant clock on the platform, and told the whole town, set your watch to mine.",
   "words": [
    20,
    38
   ],
   "subject": "master",
   "nouns": [
    {
     "word": "clock",
     "n": 2,
     "show": "clock"
    }
   ]
  },
  {
   "text": "They laughed at him.",
   "words": [
    39,
    42
   ],
   "subject": "kid"
  },
  {
   "text": "You see, when everybody shares one clock, nobody is ever late again.",
   "words": [
    43,
    54
   ],
   "subject": "master",
   "nouns": [
    {
     "word": "clock",
     "n": 3,
     "show": "clock"
    }
   ]
  }
